# Windows default: use setup.cmd and enable Tailscale in the admin link card.
# Funnel discovers its own HTTPS origin; leave this blank for the default flow.
# Optional manual HTTPS deployment: set a verified origin including its port.
# Compose reads this file; native serve reads only PUBLIC_ORIGIN.
JOB_COMPANION_PUBLIC_ORIGIN=

# Blank means only the container's actual loopback peer is local.
# Add a Docker gateway IP only after verifying the local deployment.
JOB_COMPANION_LOCAL_PEERS=
