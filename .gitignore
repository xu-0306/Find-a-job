# Publish reviewed runtime, development and CI files. Keep project records local.
/*
!/.gitignore
!/README.md
!/.dockerignore
!/.env.example
!/Dockerfile
!/compose.yaml
!/requirements.in
!/requirements.lock
!/setup.cmd
!/start.cmd
!/dev.cmd
!/app/
!/scripts/
/scripts/*
!/scripts/setup.ps1
!/scripts/dev.py
!/scripts/check.py

# Reviewed, synthetic offline checks only; keep local probes and reports private.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
!/tests/
/tests/*
!/tests/test_dev.py
!/tests/test_accounts_isolation.py
!/tests/test_chat_edit.py
!/tests/test_chat_files.py
!/tests/test_chat_retry.py
!/tests/test_conversations.py
