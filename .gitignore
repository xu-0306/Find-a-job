!/tests/test_context_budget.py
!/tests/test_m1.py
!/tests/test_m2_cards.js
!/tests/test_m2_chat_sse.js
!/tests/test_m2_chat.py
!/tests/test_m2_job_normalize.py
!/tests/test_m2_llm_wire.py
!/tests/test_m2_review_parse.py
!/tests/test_m2_reviews.py
!/tests/test_m2_source_chat.py
!/tests/test_m2_source518.py
!/tests/test_m2_sources.py
!/tests/test_m3_admin.js
!/tests/test_m3_backup_verify.py
!/tests/test_m3_common.js
!/tests/test_m3_daily.py
!/tests/test_m3_home.js
!/tests/test_m3_integration.py
!/tests/test_m3_maintenance.py
!/tests/test_m3_push_transport.py
!/tests/test_m3_sprite_validation.py
!/tests/test_m3_sprite.js
!/tests/test_m3_sw.js
!/tests/test_m4_deployment.py
!/tests/test_ports.py
!/tests/test_resume_review.py
!/tests/test_resume_chat.py
!/tests/test_resume_checklist.js
!/tests/test_search_workspace.py
!/tests/test_sharing.py
!/tests/test_start_restart.py
!/tests/test_web.py
!/tests/test_source1111.py
!/tests/test_stage3b_regressions.py
!/tests/test_stage3c_regressions.py

# Optional 1111 experimental source and probe; keep browser output and dependencies local.
!/experiments/
/experiments/*
!/experiments/1111-playwright/
/experiments/1111-playwright/*
!/experiments/1111-playwright/package.json
!/experiments/1111-playwright/package-lock.json
!/experiments/1111-playwright/probe.mjs
!/experiments/1111-playwright/probe.test.mjs
!/experiments/1111-playwright/session.mjs
!/experiments/1111-playwright/session.test.mjs
!/experiments/1111-playwright/source.mjs
!/experiments/1111-playwright/source.test.mjs
!/experiments/1111-playwright/source.budget.test.mjs
!/experiments/1111-playwright/README.md

# Never publish generated data or credentials, even under an allowed directory.
__pycache__/
*.py[cod]
.env
.env.*
!/.env.example
*.db
*.db-*
*.sqlite
*.sqlite3
*.pem
*.key
*.pfx
*.p12
*.log
